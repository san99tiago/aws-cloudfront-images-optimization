# Reference file: copy it to ".env" and fill the values (".env" is gitignored).
#   cp .example.env .env

# OpenAI Platform key, only used by scripts/generate_images.py (local, one-off)
OPENAI_API_KEY=sk-proj-REPLACE_ME
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high

# Password shared by the 3 demo Cognito users (min 8 chars, upper, lower, digit, symbol).
# It is sent to CloudFormation as a NoEcho parameter, stored in AWS Secrets Manager and
# read at runtime by the seeder Lambda (it never lands in the synthesized template).
DEMO_USERS_PASSWORD=REPLACE_ME

# Deployment
AWS_REGION=us-east-1
DEPLOYMENT_ENVIRONMENT=dev
